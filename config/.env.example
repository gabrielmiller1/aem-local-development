# aem-local-development configuration
#
# Copy this file to .env at the repo root (or run `./aem configure`, which
# does it for you) and change only what you need. Every port below is read
# once by the ./aem script and propagated to every component that depends
# on it — Author, Publish, the SSL proxy, the Universal Editor Service, the
# Dispatcher, the generated OSGi configs, and the URLs `./aem status` prints.
# You never need to edit a port in more than one place.

# --- AEM instances ---------------------------------------------------------
AEM_AUTHOR_PORT=4502
AEM_PUBLISH_PORT=4503

# --- Dispatcher (Docker only — see README) ---------------------------------
DISPATCHER_PORT=8080

# --- Universal Editor Service -----------------------------------------------
# The service's own built-in default is 8080, which collides with the
# Dispatcher default above, so we pin it explicitly.
UES_PORT=8000

# --- Local HTTPS (local-ssl-proxy in front of Author/Publish) --------------
SSL_AUTHOR_PORT=8443
SSL_PUBLISH_PORT=8444

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call Author/Publish (needed by
# the Universal Editor and any local frontend dev server). Applied to both
# tiers unless you set the _AUTHOR / _PUBLISH variants below.
CORS_ALLOWED_ORIGINS=https://localhost:3000

# Optional per-tier overrides (uncomment to diverge from CORS_ALLOWED_ORIGINS):
# CORS_ALLOWED_ORIGINS_AUTHOR=https://localhost:3000
# CORS_ALLOWED_ORIGINS_PUBLISH=https://localhost:3000

# --- Java --------------------------------------------------------------------
# The AEM SDK requires Java 21. If `java -version` on your machine is not 21,
# point this at a JDK 21 home instead of changing your global default.
# AEM_JAVA_HOME=

# --- Admin credentials --------------------------------------------------------
# Not set here on purpose: the AEM SDK quickstart's own default local
# credential is admin/admin, and this project does not manage or override
# AEM passwords — that's normal day-2 AEM administration, not local infra
# bootstrap. Change it yourself via AEM (Tools > Security > Users) once the
# instance is up, the same as you would on any other local AEM install.
